{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 ;; Unit specs. Property specs live in their own root so they stay out of
 ;; coverage, CRAP, and mutation, per the constitution.
 {:spec {:extra-paths ["spec"]
         :extra-deps {speclj/speclj {:mvn/version "3.13.0"}}
         :main-opts ["-m" "speclj.main" "-c"]}
  :property {:extra-paths ["spec-property"]
             :extra-deps {speclj/speclj {:mvn/version "3.13.0"}
                          org.clojure/test.check {:mvn/version "1.1.1"}}
             :main-opts ["-m" "speclj.main" "-c" "spec-property"]}
  :cov {:extra-paths ["spec"]
        :extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}
                     speclj/speclj {:mvn/version "3.13.0"}}
        :main-opts ["-m" "speclj.cloverage" "--" "-p" "src" "-s" "spec" "--lcov"]}}}
